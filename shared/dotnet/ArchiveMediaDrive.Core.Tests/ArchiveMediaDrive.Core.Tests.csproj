  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ArchiveMediaDrive.Core/ArchiveMediaDrive.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\contracts\fixtures\sources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fixtures\sources.json</Link>
    </None>
    <None Include="..\..\..\runtime\rclone\manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtime\rclone\manifest.json</Link>
    </None>
  </ItemGroup>
